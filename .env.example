# ── LLM Providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
LLM_MODEL=gemini-3.5-flash
VISION_MODEL=gemini-3.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Vector Database ────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=logmind-index

# ── Local LLM (Ollama) ────────────────────────────────────────────────────
# Leave empty or set to http://ollama:11434 when using Docker Compose Ollama service
OLLAMA_BASE_URL=

# ── Embedding config ──────────────────────────────────────────────────────
# Must match the Pinecone index dimension (768 with the default embedding configuration)
EMBEDDING_DIM=768
EMBEDDING_MODEL=gemini-embedding-001

# ── Application ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
